# Database SQLite (path relatif terhadap folder prisma/). Bisa di-override untuk pengujian.
DATABASE_URL="file:./newsroom.db"

# Salin menjadi .env.local untuk pengembangan lokal.
# WAJIB diisi di produksi (jika kosong, session secret acak per proses + peringatan).
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter!!

# Base path saat dipublish di slug platform (harus sama dengan slug)
NEXT_PUBLIC_BASE_PATH=

# ===== STORAGE (footage/gambar) =====
# Konfigurasi storage juga bisa diatur dari aplikasi:
#   Pengaturan → Storage & Integrasi (mode Lokal atau S3 Compatible + tombol Uji Koneksi).
# Setting dari aplikasi MENANG atas variabel di bawah ini.
#
# driver: local -> simpan di folder uploads/ (default, pengembangan)
# driver: s3    -> penyedia S3-compatible (BunnyCDN, R2, AWS S3, Spaces, Wasabi, B2, MinIO).
#                 Nilai lama "bunny" tetap diterima dan diperlakukan sebagai s3.
STORAGE_DRIVER=local

# Contoh BunnyCDN Storage (S3 compatible) — isi saat produksi
S3_ENDPOINT=https://sg.storage.bunnycdn.com
S3_BUCKET=nama-storage-zone
S3_ACCESS_KEY_ID=nama-storage-zone
S3_SECRET_ACCESS_KEY=
S3_REGION=de
S3_PUBLIC_URL=https://nama-pull-zone.b-cdn.net
S3_PREFIX=newsroom
S3_FORCE_PATH_STYLE=true

# (Kompatibilitas) nama variabel versi lama — masih dibaca sebagai fallback
# BUNNY_STORAGE_ENDPOINT=/BUNNY_STORAGE_ZONE=/BUNNY_STORAGE_ACCESS_KEY=/BUNNY_CDN_URL=
